# ============================================================
# CaseGrid — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=casegrid
POSTGRES_PASSWORD=casegrid_secret
POSTGRES_DB=casegrid_db
DATABASE_URL=postgresql://casegrid:casegrid_secret@postgres:5432/casegrid_db

# ── MinIO (S3-compatible object storage) ────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=casegrid_minio
MINIO_SECRET_KEY=casegrid_minio_secret
MINIO_BUCKET=casegrid-documents
MINIO_USE_SSL=false

# ── JWT Authentication ─────────────────────────────────────
JWT_SECRET=casegrid-jwt-super-secret-change-in-prod
JWT_EXPIRES_IN=24h

# ── AES-256 Encryption ─────────────────────────────────────
# 32-byte hex key (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# ── Integrity Provider ─────────────────────────────────────
# "custom" = in-DB chain (default)
# "fabric" = Hyperledger Fabric (future)
INTEGRITY_PROVIDER=custom

# ── Backend Server ──────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:5001/api
